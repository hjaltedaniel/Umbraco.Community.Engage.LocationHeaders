<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ContentTargetFolders>.</ContentTargetFolders>
    <Product>Umbraco.Community.Engage.LocationHeaders</Product>
    <PackageId>Umbraco.Community.Engage.LocationHeaders</PackageId>
    <Title>Engage - Location Headers</Title>
    <Description>Uses location headers from your CDN, Azure Front Door, or similar services as the source of location data for Umbraco Engage on Umbraco 13, 17, and 18.</Description>
    <PackageReadmeFile>README_nuget.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>umbraco;umbraco-marketplace</PackageTags>
    <RootNamespace>Umbraco.Community.Engage.LocationHeaders</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Version>0.2.2</Version>
    <Authors>Hjalte Daniel Retz Johansson</Authors>
    <Copyright>$([System.DateTime]::UtcNow.ToString(`yyyy`)) © Hjalte Daniel Retz Johansson</Copyright>
    <PackageProjectUrl>https://github.com/hjaltedaniel-umbraco/Umbraco.Community.Engage.LocationHeaders</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hjaltedaniel-umbraco/Umbraco.Community.Engage.LocationHeaders</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="Umbraco.Cms.Core" Version="13.16.2" />
    <PackageReference Include="Umbraco.Engage.Core" Version="13.8.1" />
    <!-- Keep transitive dependencies on patched releases. -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.5" />
  </ItemGroup>
  
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <PackageReference Include="Umbraco.Cms.Core" Version="17.7.1" />
    <PackageReference Include="Umbraco.Engage.Core" Version="17.5.0" />
    <!-- Keep transitive dependencies on patched releases. -->
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\docs\README_nuget.md" Pack="true" PackagePath="\" />
    <None Include="..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
